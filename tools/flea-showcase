# The closer absorbs the remainder of the target, so the run ends on the mark exactly when the
# voiceover does. A hold longer than one caption turn is split between the two empty folders the
# run has, Scans and the Contact sheet the transfer beat emptied again, so no sentence repeats in place.
run_started_ms=0
beat_closer() {
    local remaining segments each i here
    beat closer "the mark, for whatever of the voiceover is left"
    remaining=$(( target_s - ( $(now_ms) - run_started_ms ) / 1000 ))
    if (( remaining < 8 )); then
        printf 'CLOSER the beats ran %s s past the target; holding 8 s, trim before the take\n' "$(( 8 - remaining ))"
        remaining=8
    fi
    segments=$(( (remaining + caption_turn_s - 1) / caption_turn_s ))
    (( segments > 4 )) && segments=4
    each=$(( remaining / segments ))
    printf 'CLOSER %s s left, %s hold(s) of about %s s\n' "$remaining" "$segments" "$each"
    for (( i = 0; i < segments; i++ )); do
        if (( i % 2 == 0 )); then here="$fixture/Scans"; else here="$photos/Contact sheet"; fi
        goto_path "$here"
        expect_ipc emptyShown true
        # The last hold takes the clock's own remainder, so the transitions above never push past the target.
        if (( i == segments - 1 )); then
            each=$(( target_s - ( $(now_ms) - run_started_ms ) / 1000 ))
            (( each < 3 )) && each=3
        fi
        (( i == 0 )) && shot closer
        dwell "$each"
    done
    shot end
}

all_beats="open drag click roll transfer newfolder scale views theme quicklook errors sort filter search rename trash menu rail keys closer"

run_beats() {
    local beats="${*:-$all_beats}" b started
    load_state
    [[ -n "$(client_json "$addr_a")" ]] || fail "the staged window is gone, run stage again"
    park_pointer
    started=$(now_ms)
    run_started_ms=$started
    for b in $beats; do
        declare -F "beat_$b" >/dev/null || fail "no beat called $b (have: $all_beats)"
        "beat_$b"
    done
    close_beat
    printf 'TOTAL %.1f s\n' "$(( $(now_ms) - started ))e-3"
}

