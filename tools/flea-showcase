#!/usr/bin/env bash
# The showcase drive: a stage-set home, the whole monitor as the stage, and the beats of
# showcase-script.md (in .superpowers/sdd/2026-09-01-flea-1to1-buildout/) choreographed inside it.
#   tools/flea-showcase fixture               build the stage-set home and list it, no window
#   tools/flea-showcase stage                 fixture, then the window inside the stage; prints the region
#   tools/flea-showcase record                record the whole monitor at native size, 60 fps, QP ultra
#   tools/flea-showcase run [beat ...]        play the beats against the staged window
#   tools/flea-showcase stop                  stop the recording; prints size, duration, resolution and codec
#   tools/flea-showcase dry-run [beat ...]    stage, run with a shot per beat, theme-check, teardown
#   tools/flea-showcase theme-check           stage, switch themes and shoot every surface under each, teardown
#   tools/flea-showcase teardown              windows closed; bar, quiet and theme restored and verified; fixture deleted
# Beats: open drag click roll transfer newfolder scale views theme quicklook errors sort filter search rename trash menu rail keys closer
# The take is timed to the operator's voiceover: the closer holds on the empty-state mark for whatever
# of target_s the beats before it left, so the run ends on the brand drawing itself, exactly on time.
# Every key is followed by a read of its consequence over IPC: a clean exit from the drive tool is
# not evidence that a key arrived, and one form of it has already passed while pressing nothing.
# Hard rule 9: every write and delete is inside a sandbox tools/flea-sandbox-guard made, and the
# window runs under a HOME inside that sandbox, so no real file is ever on screen or in reach.
set -u
set -o pipefail
# /home/demo is the operator-made root for the take, so the breadcrumb never shows a sandbox name;
# the guard resolves its root when sourced, so this has to be set first.
export FLEA_FIXTURE_ROOT=${FLEA_FIXTURE_ROOT:-/home/demo}
. "$(dirname "$0")/../tools/flea-sandbox-guard"

repo=$(cd "$(dirname "$0")/.." && pwd) || exit 1
ui=$repo/ui
bin=${FLEA_BIN:-$repo/target/release/flea}
# The fixture is a whole home: the rail, the tilde in the path bar and the home-wide search all read $HOME.
fixture=$FIXTURE_ROOT/flea-showcase
# The stage set the home is hard-linked from: tools/flea-showcase-content's studio, built from
# nothing and safe for a public timeline. Re-pointed here and nowhere else.
stage_src=${FLEA_SHOWCASE_SRC:-/home/flea-sandbox/flea-showcase-content/studio}
bench_dir=${FLEA_BENCH_DIR:-/home/flea-sandbox/flea-bench-btrfs}
# The transfer beat copies this many camera-roll frames: the content lane measured 300 items in
# 505 ms through the backend, so about 2,400 is a four-second progress line, and at some 540 KB a
# frame it is 1.3 GB of copy that the undo removes again.
roll_batch=2400
# The stage is the whole monitor, recorded at its native size with the bar hidden for the take, so
# stage_w and stage_h are read from the compositor and never assumed.
stage_w=0
stage_h=0
# The main window at rest: wide enough to fill the frame without the name column running empty,
# tall enough for the whole rail. Read against the boards at the dry run, not assumed right.
width=1280
height=860
# The drag pair: both windows the same size, side by side with this gap, centred as a pair.
pair_w=1180
gap=24
# The grid beat grows the window to this; nothing here ever goes below 1000 wide, because the
# column collapse under about 659 px is deferred to v0.1.1 and stays off camera.
grow_w=1720
grow_h=1000
# The DEVICES rail labels the internal disk with the box's hostname, and the take is public, so the
# group is hidden by default through an lsblk that reports no disk; FLEA_SHOWCASE_HIDE_DEVICES=0 shows it.
hide_devices=${FLEA_SHOWCASE_HIDE_DEVICES:-1}
# The recorder, called directly: the stock command reaches only its very_high preset and a picker.
gsr_codec=${FLEA_SHOWCASE_CODEC:-h264}
gsr_quality=ultra
gsr_fps=60
# Pinned like tests/ui.sh's evidence paths: a path the environment can move is a path nothing checks.
work=/tmp/flea-showcase
state=$work/state
evidence=$work/evidence
flea_log=$work/flea.log
# A typed query lands at a reading pace rather than all at once.
type_ms=90
# The pointer parks in the screen corner, outside the stage, so the recording shows it only when a beat brings it in.
park_x=2559
park_y=1439
# The backend's own DRAIN_LIMIT is 25 s, the same wait tests/ui.sh gives it.
drain_wait_s=30
# The status bar clears a transient after 4000 ms, so a line meant to be read is dwelt on for less.
read_s=3
# The window coalescer is 16 ms and a refill is a round trip, the same settle tests/ui.sh uses.
settle_s=0.4
# The empty-state mark paints in over 0.2 + 1.8 s and the caption turns every 2.8 s (ui/FleaMark.qml,
# ui/EmptyState.qml), so a dwell of one full turn shows the whole stroke and the finished mark.
mark_turn_s=3.0
# The bench mirror's row count, and the hits name_777 finds in it: 777, 7770 to 7779, 77700 to 77799.
bench_rows=100000
search_hits=111
# The camera roll's row count, from tools/flea-showcase-content's own default.
roll_rows=8000
# The voiceover's length in seconds, measured off the operator's file (384.192 s); the run ends on it.
target_s=${FLEA_SHOWCASE_TARGET_S:-384}
# The empty-state caption turns through eight sentences at 2,800 ms, so a hold longer than one turn
# shows a sentence twice; the closer splits a long hold across two empty folders at this length.
caption_turn_s=22
# The opener: the recording begins on the mark already painting, held under one caption turn.
opener_s=12
shots=${SHOTS:-0}
flea_window_class=com.thisisgm.flea

fail() {
    printf 'flea-showcase: %s\n' "$*" >&2
    exit 1
}

export PATH="$HOME/.local/bin:$PATH"
command -v omarchy-drive >/dev/null || fail "omarchy-drive is not on PATH"
eval "$(omarchy-drive env)"

# omarchy-drive env omits the Qt platform theme, without which no row icon resolves; the same
# three-step recovery tests/ui.sh uses, ending at a live client's own environment.
platform_theme() {
    systemctl --user show-environment | grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-
}
platform_theme_from_a_live_client() {
    local pid
    pid=$(pgrep -x quickshell | head -1)
    [[ -n "$pid" ]] || return 0
    tr '\0' '\n' < "/proc/$pid/environ" | grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-
}
[[ -n "${QT_QPA_PLATFORMTHEME:-}" ]] || export QT_QPA_PLATFORMTHEME="$(platform_theme)"
[[ -n "$QT_QPA_PLATFORMTHEME" ]] || export QT_QPA_PLATFORMTHEME="$(platform_theme_from_a_live_client)"
[[ -n "$QT_QPA_PLATFORMTHEME" ]] || fail "nothing published QT_QPA_PLATFORMTHEME, so no row would draw an icon"

# The real home, read before anything below points HOME at the fixture.
real_home=$HOME
real_state=$real_home/.local/state/omarchy/current
real_shell_toml=$real_home/.config/omarchy/shell.toml

# ------------------------------------------------------------------ the stage geometry

# Sample input, hyprctl monitors -j, one monitor: {"name":"DP-2","width":2560,"height":1440,"x":0,"y":0,"reserved":[0,30,0,0],...}
# corner: one monitor at scale 1 on this box, so logical pixels are physical pixels and nothing divides.
# With the bar hidden the strut is 0 and the stage is the whole monitor; if it stays, the windows
# keep out from under it and the recording still covers the monitor.
stage_x=0
stage_y=0
monitor=""
read_stage() {
    local mon_w mon_h mon_x mon_y top
    read -r monitor mon_w mon_h mon_x mon_y top < <(hyprctl monitors -j | jq -r '.[0] | "\(.name) \(.width) \(.height) \(.x) \(.y) \(.reserved[1])"')
    [[ -n "$top" ]] || fail "hyprctl monitors answered nothing, so there is no stage to place"
    stage_x=$mon_x
    stage_y=$(( mon_y + top ))
    stage_w=$mon_w
    stage_h=$(( mon_h - top ))
}

# Where the main window rests: centred in the stage.
rest_x() { printf '%s' $(( stage_x + (stage_w - width) / 2 )); }
rest_y() { printf '%s' $(( stage_y + (stage_h - height) / 2 )); }
# The drag pair, centred as a pair: the main window shrinks to pair_w and slides left, the second sits right.
pair_x() { printf '%s' $(( stage_x + (stage_w - 2 * pair_w - gap) / 2 )); }
side_x() { printf '%s' $(( $(pair_x) + pair_w + gap )); }
pair_y() { printf '%s' $(( stage_y + (stage_h - height) / 2 )); }
grow_x() { printf '%s' $(( stage_x + (stage_w - grow_w) / 2 )); }
grow_y() { printf '%s' $(( stage_y + (stage_h - grow_h) / 2 )); }

# ------------------------------------------------------------------ the bar

bar_shown() {
    omarchy-drive layers 2>/dev/null | grep -q 'omarchy-bar'
}

# Workspaces, clock, weather, tray and every presence widget live in the bar, and the take is
# public, so it goes for the take through Omarchy's own toggle and comes back only if it was there.
bar_hide() {
    if bar_shown; then
        printf 'bar=shown\n' >> "$state"
        omarchy toggle bar off >/dev/null 2>&1
        for _attempt in $(seq 1 60); do
            bar_shown || break
            sleep 0.05
        done
        bar_shown && fail "the bar would not hide; omarchy toggle bar off did not take"
    else
        printf 'bar=hidden\n' >> "$state"
    fi
}

bar_restore() {
    [[ -f "$state" ]] || return 0
    grep -qx 'bar=shown' "$state" || return 0
    bar_shown || omarchy toggle bar on >/dev/null 2>&1
    for _attempt in $(seq 1 60); do
        bar_shown && { printf 'BAR restored, verified on screen\n'; return 0; }
        sleep 0.05
    done
    printf 'flea-showcase: THE BAR DID NOT COME BACK; run: omarchy toggle bar on\n' >&2
    return 1
}

# ------------------------------------------------------------------ notifications

# The shell's own answer, measured on this box as the words "on" and "off" (not true/false); anything
# else means the shell did not answer, and a toggle issued on a guess is the one way to invert the
# operator's setting, so an unreadable state is a refusal.
dnd_state() {
    local seen
    seen=$(omarchy-shell notifications isDnd 2>/dev/null)
    case "$seen" in
        on|off) printf '%s' "$seen" ;;
        *) fail "the shell answered '$seen' for do-not-disturb, not on or off, so nothing is toggled" ;;
    esac
}

# A toast mid-take is a wasted take and somebody's name in the frame, so do-not-disturb goes on
# through the stock toggle, recorded, verified, and undone only if this drive turned it on.
dnd_on() {
    if [[ "$(dnd_state)" == "on" ]]; then
        printf 'dnd=was_on\n' >> "$state"
        return 0
    fi
    printf 'dnd=turned_on\n' >> "$state"
    omarchy toggle notification silencing >/dev/null 2>&1
    for _attempt in $(seq 1 60); do
        [[ "$(dnd_state)" == "on" ]] && return 0
        sleep 0.05
    done
    fail "do-not-disturb did not turn on; the shell answers '$(dnd_state)'"
}

dnd_restore() {
    [[ -f "$state" ]] || return 0
    grep -qx 'dnd=turned_on' "$state" || return 0
    [[ "$(dnd_state)" == "on" ]] && omarchy toggle notification silencing >/dev/null 2>&1
    for _attempt in $(seq 1 60); do
        [[ "$(dnd_state)" == "off" ]] && { printf 'DND restored, verified off\n'; return 0; }
        sleep 0.05
    done
    printf 'flea-showcase: DO-NOT-DISTURB IS STILL ON; run: omarchy toggle notification silencing\n' >&2
    return 1
}

# ------------------------------------------------------------------ the fixture

# A home, not a folder: what the rail lists, what ~ means and what a home-wide search walks are all
# this directory, so nothing of the operator's is ever in frame. Its contents are the stage set's
# nine entries, hard-linked (same btrfs subvolume, seconds, no space), plus the bench mirror and a
# second camera-roll batch for the transfer beat, plus the dotfiles the rail and the theme read.
fixture_build() {
    local entry name
    [[ -d "$stage_src" ]] || fail "the stage set is missing at $stage_src; run tools/flea-showcase-content build"
    [[ -d "$bench_dir" ]] || fail "the 100,000-file fixture is missing at $bench_dir"
    sandbox_make "$fixture"
    for entry in "$stage_src"/* "$stage_src"/.[!.]*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        name=${entry##*/}
        [[ "$name" == "$SANDBOX_MARKER" ]] && continue
        # The closed folder cannot be read to link its contents, and it has none: it is remade closed.
        if [[ ! -r "$entry" && -d "$entry" && ! -L "$entry" ]]; then
            mkdir "$fixture/$name" || fail "could not make $name"
            touch -r "$entry" "$fixture/$name" 2>/dev/null || true
            chmod 0000 "$fixture/$name" || fail "could not close $name"
            continue
        fi
        cp -al "$entry" "$fixture/$name" || fail "could not link $name into the home"
    done
    mkdir -p "$fixture/.config/omarchy" "$fixture/.local/state/omarchy" "$fixture/.local/share" "$fixture/.local/bin"
    # The live theme, live switches included: theme-set replaces files inside current/ and never
    # current/ itself, so a link to the directory follows every switch. tests/drag.sh does the same.
    ln -sfn "$real_state" "$fixture/.local/state/omarchy/current"
    # A box with no user shell.toml renders at 12, and this one has one, so it is carried faithfully.
    [[ -f "$real_shell_toml" ]] && cp "$real_shell_toml" "$fixture/.config/omarchy/shell.toml"
    # The rail's favourites come from this file: the stage set's own folders, under the XDG names.
    printf 'XDG_DOCUMENTS_DIR="$HOME/Documents"\nXDG_DOWNLOAD_DIR="$HOME/Downloads"\nXDG_PICTURES_DIR="$HOME/Photos"\nXDG_MUSIC_DIR="$HOME/Recordings"\n' \
        > "$fixture/.config/user-dirs.dirs"
    # A hard-link mirror of the bench fixture, 2 s to make and the same 100,000 inodes, so the scale
    # beat descends into a real directory inside this home.
    cp -al "$bench_dir" "$fixture/Downloads/dataset"
    rm -f "$fixture/Downloads/dataset/.flea-bench-fixture"
    # A second day of the camera roll, the last roll_batch frames linked under their own names, so
    # the transfer beat has a batch worth a progress line without copying all 8,000.
    mkdir -p "$fixture/Photos/Camera roll, day two"
    ls "$stage_src/Photos/Camera roll" | sort | tail -n "$roll_batch" | while IFS= read -r name; do
        ln "$stage_src/Photos/Camera roll/$name" "$fixture/Photos/Camera roll, day two/$name"
    done
    touch -d '2026-09-02 07:15' "$fixture/Photos/Camera roll, day two"
    # The rail self-hides its DEVICES group on a box lsblk reports no disk for (ui/Sidebar.qml), and
    # the group is the one place the hostname is drawn, so the window gets an lsblk that reports none.
    printf '#!/bin/sh\nprintf %%s "{\\"blockdevices\\": []}"\n' > "$fixture/.local/bin/lsblk"
    # Enter on a file hands it to xdg-open, and a stray application over the take is a wasted take,
    # so the window's xdg-open logs the path instead. Nothing in the beats opens a file on purpose.
    printf '#!/bin/sh\nprintf %%s\\\\n "$1" >> "%s/opened.log"\n' "$work" > "$fixture/.local/bin/xdg-open"
    chmod +x "$fixture/.local/bin/lsblk" "$fixture/.local/bin/xdg-open"
    printf 'FIXTURE %s\n' "$fixture"
    ls -A -l "$fixture"
    printf 'ROLL day two: %s frames\n' "$(ls "$fixture/Photos/Camera roll, day two" | wc -l)"
}

# The closed folder is owned by whoever built it, so a chmod reopens it before the guard's rm -rf.
fixture_remove() {
    [[ -d "$fixture/Client vault" ]] && chmod 0700 "$fixture/Client vault" 2>/dev/null
    sandbox_remove "$fixture"
}

# ------------------------------------------------------------------ instances and windows

# The main window and the drag beat's second one, each pinned by pid: two instances share one
# config path, so a path is not an instance selector and a class is not a window selector.
pid_a=0; id_a=""; addr_a=""
pid_b=0; id_b=""; addr_b=""

# Sample input, qs list --all --json, one entry: {"config_path":"/home/gm/Work/claude/flea/ui/shell.qml","id":"c0o12e9frkt","pid":3437004,...}
instance_id_of_pid() {
    qs list --all --json 2>/dev/null | jq -r --argjson p "$1" '.[] | select(.pid == $p) | .id'
}

ipc() {
    qs ipc -i "$id_a" call flea "$@" 2>/dev/null
}

ipc_b() {
    qs ipc -i "$id_b" call flea "$@" 2>/dev/null
}

# Sample input, one hyprctl client: {"address":"0x5a1c","pid":3437004,"at":[780,385],"size":[1000,700],"floating":true,...}
client_json() {
    hyprctl clients -j | jq -c --arg a "$1" '.[] | select(.address == $a)'
}

client_geometry() {
    client_json "$1" | jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"'
}

# Keystrokes land on whatever holds focus, so a foreign window on the box is a reason to stop and
# not to work around. The Omarchy bar is a layer surface and never appears here.
assert_box_clear() {
    local others
    others=$(hyprctl clients -j | jq -r '.[] | .class' | sort -u | tr '\n' ' ')
    [[ -z "$others" ]] || fail "another lane holds the display, these windows are open: $others"
}

# The product's own launcher under the fixture home, with both seams on the launch line so a packaged
# /usr/share/flea/ui can never outrank this tree. 3>&- 4>&- so a detached qs inherits no lock
# descriptor from whatever called this drive. Prints "pid id address".
spawn() {
    local dir="$1" pid id="" addr=""
    [[ -x "$bin" ]] || fail "no binary at $bin, build it first"
    mkdir -p "$work" "$evidence"
    [[ "$hide_devices" == 1 ]] || rm -f "$fixture/.local/bin/lsblk"
    HOME="$fixture" PATH="$fixture/.local/bin:$PATH" FLEA_UI="$ui" FLEA_BIN="$bin" setsid nohup "$bin" --gui "$dir" >>"$flea_log" 2>&1 </dev/null 3>&- 4>&- &
    pid=$!
    for _attempt in $(seq 1 300); do
        addr=$(hyprctl clients -j | jq -r --arg c "$flea_window_class" --argjson p "$pid" '.[] | select(.class == $c and .pid == $p) | .address')
        [[ -n "$addr" ]] && break
        sleep 0.05
    done
    [[ -n "$addr" ]] || fail "no Flea window for pid $pid appeared in 15 s"
    for _attempt in $(seq 1 100); do
        id=$(instance_id_of_pid "$pid")
        [[ -n "$id" ]] && break
        sleep 0.05
    done
    [[ -n "$id" ]] || fail "qs list never named an instance for pid $pid"
    printf '%s %s %s\n' "$pid" "$id" "$addr"
}

dispatch() {
    hyprctl dispatch "$1" >/dev/null
}

# Float, size and place one window, then read the compositor back: hyprctl exits 0 on error, so the
# geometry is the only evidence anything took. The resize falls back to a delta and the move to a
# relative one, because the exact and absolute forms are read back rather than trusted.
place() {
    local addr="$1" x="$2" y="$3" w="$4" h="$5" wx wy ww wh
    if [[ "$(client_json "$addr" | jq -r '.floating')" != "true" ]]; then
        dispatch "hl.dsp.window.float({ window = \"address:$addr\" })"
        settle
    fi
    [[ "$(client_json "$addr" | jq -r '.floating')" == "true" ]] || fail "window $addr would not float"
    dispatch "hl.dsp.window.resize({ x = $w, y = $h, exact = true, window = \"address:$addr\" })"
    settle
    read -r wx wy ww wh < <(client_geometry "$addr")
    if (( ww != w || wh != h )); then
        dispatch "hl.dsp.window.resize({ x = $((w - ww)), y = $((h - wh)), window = \"address:$addr\" })"
        settle
    fi
    dispatch "hl.dsp.window.move({ x = $x, y = $y, window = \"address:$addr\" })"
    settle
    read -r wx wy ww wh < <(client_geometry "$addr")
    if (( wx != x || wy != y )); then
        dispatch "hl.dsp.window.move({ x = $((x - wx)), y = $((y - wy)), relative = true, window = \"address:$addr\" })"
        settle
    fi
    read -r wx wy ww wh < <(client_geometry "$addr")
    (( ww == w && wh == h && wx == x && wy == y )) \
        || fail "window $addr is ${ww}x${wh} at $wx,$wy, not ${w}x${h} at $x,$y"
    printf 'WINDOW %s %sx%s at %s,%s\n' "$addr" "$ww" "$wh" "$wx" "$wy"
}

close_window() {
    local addr="$1"
    dispatch "hl.dsp.window.close({ window = \"address:$addr\" })"
    for _attempt in $(seq 1 100); do
        [[ -z "$(client_json "$addr")" ]] && return
        sleep 0.05
    done
    fail "window $addr did not close"
}

flea_pids() {
    local pid
    for pid in $(pgrep -x qs || true); do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        if tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq "$ui"; then
            printf '%s\n' "$pid"
        fi
    done
}

backend_pids() {
    local pid
    for pid in $(pgrep -x flea || true); do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        if tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq -- "$bin --backend"; then
            printf '%s\n' "$pid"
        fi
    done
}

# Every qs running under the fixture home, which is exactly the set this drive launched and nothing
# another lane did: the environment is read, not the command line, because both share one config path.
fixture_instances() {
    local pid
    for pid in $(pgrep -x qs || true); do
        [[ -r "/proc/$pid/environ" ]] || continue
        if tr '\0' '\n' 2>/dev/null < "/proc/$pid/environ" | grep -qx "HOME=$fixture"; then
            printf '%s\n' "$pid"
        fi
    done
}

# kill -0 0 would ask after this shell's own process group, so an unset pid is never signalled.
alive() {
    (( ${1:-0} > 0 )) && kill -0 "$1" 2>/dev/null
}

kill_flea() {
    local pid waited
    for pid in $(fixture_instances); do
        kill "$pid" 2>/dev/null
    done
    for waited in $(seq 1 $((drain_wait_s * 20))); do
        [[ -z "$(fixture_instances)$(backend_pids)" ]] && return
        sleep 0.05
    done
    fail "a backend was still draining after $drain_wait_s s"
}

# ------------------------------------------------------------------ keys and their proof

settle() {
    sleep "$settle_s"
}

dwell() {
    sleep "$1"
}

# Plain keys and text go through wtype, aimed at the main window by address, which focuses it first.
# Never with a leading "--": omarchy-drive key --window flea -- z exits clean and presses nothing.
key() {
    [[ "$1" != -- ]] || fail "key: a -- argument is silently dropped, pass the text bare"
    omarchy-drive key --window "$addr_a" "$@" >/dev/null
}

# A query typed at a reading pace; wtype's -d is the gap between characters.
type_text() {
    [[ "$1" != -* ]] || fail "type_text: '$1' would be read as a flag"
    key -d "$type_ms" "$1"
}

# A modifier chord through wtype, the one route a lane has watched deliver a chord on this box:
# send_shortcut's keysym lookup fails for letters and digits alike, and --global is a compositor
# key press. Released in reverse order, the way a hand comes off a chord.
# Sample call: chord ctrl+shift n  ->  omarchy-drive key --window <addr> -M ctrl -M shift n -m shift -m ctrl
chord() {
    local mods="$1" k="$2" parts pre=() post=() i
    IFS='+' read -ra parts <<< "$mods"
    for i in "${parts[@]}"; do pre+=(-M "$i"); done
    for (( i=${#parts[@]} - 1; i >= 0; i-- )); do post+=(-m "${parts[i]}"); done
    key "${pre[@]}" "$k" "${post[@]}"
}

# Polls one seam until it answers the wanted value: the proof a key landed, where an exit status is not.
expect() {
    local label="$1" want="$2" seen
    shift 2
    for _attempt in $(seq 1 100); do
        seen=$("$@" 2>/dev/null)
        [[ "$seen" == "$want" ]] && return 0
        sleep 0.05
    done
    fail "$label: expected '$want', got '$seen'"
}

expect_ipc() {
    local method="$1" want="$2"
    shift 2
    expect "ipc $method" "$want" ipc "$method" "$@"
}

# The status bar's line, matched on a substring because the counts and names in it belong to the fixture.
expect_message_has() {
    local want="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc lastMessage 2>/dev/null)
        [[ "$seen" == *"$want"* ]] && { printf 'BAR %s\n' "$seen"; return 0; }
        sleep 0.05
    done
    fail "status bar: expected it to say '$want', it says '$seen'"
}

expect_message_has_b() {
    local want="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc_b lastMessage 2>/dev/null)
        [[ "$seen" == *"$want"* ]] && { printf 'BAR(b) %s\n' "$seen"; return 0; }
        sleep 0.05
    done
    fail "second window's status bar: expected '$want', it says '$seen'"
}

expect_selection_past() {
    local floor="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc selectionCount 2>/dev/null)
        [[ "$seen" =~ ^[0-9]+$ ]] && (( seen > floor )) && return 0
        sleep 0.05
    done
    fail "selection: expected more than $floor rows, it holds '$seen'"
}

expect_cursor_past() {
    local floor="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc cursor 2>/dev/null)
        [[ "$seen" =~ ^[0-9]+$ ]] && (( seen > floor )) && return 0
        sleep 0.05
    done
    fail "cursor: expected past $floor, it is '$seen'"
}

# The row under the cursor, by a name pattern, polled because a rename lands on a round trip.
expect_cursor_row() {
    local want="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc rowAt "$(ipc cursor 2>/dev/null)" 2>/dev/null)
        [[ "${seen%%|*}" == $want ]] && return 0
        sleep 0.05
    done
    fail "cursor row: expected $want, got '$seen'"
}

expect_file() {
    for _attempt in $(seq 1 300); do
        [[ -e "$1" ]] && return 0
        sleep 0.05
    done
    fail "no file appeared at $1"
}

expect_no_file() {
    for _attempt in $(seq 1 300); do
        [[ -e "$1" ]] || return 0
        sleep 0.05
    done
    fail "$1 is still there"
}

# A transfer crosses a process boundary and lands on disk row by row, so its total gets a longer wait.
transfer_wait_s=60
wait_total() {
    local want="$1" seen
    for _attempt in $(seq 1 $((transfer_wait_s * 10))); do
        seen=$(ipc total 2>/dev/null)
        [[ "$seen" == "$want" ]] && return 0
        sleep 0.1
    done
    fail "the listing never reached $want rows, it is at '$seen'"
}

# The rename field opens on a round trip, so a key typed at once would land on the list instead.
wait_renaming() {
    local seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc renamingIndex 2>/dev/null)
        [[ "$seen" =~ ^[0-9]+$ ]] && return 0
        sleep 0.05
    done
    fail "no rename field opened, renamingIndex is '$seen'"
}

wait_listing() {
    local want="$1" total row
    for _attempt in $(seq 1 600); do
        total=$(ipc total 2>/dev/null || printf unavailable)
        row=$(ipc rowAt 0 2>/dev/null || printf loading)
        [[ "$total" == "$want" && "$row" != "loading" ]] && return
        sleep 0.05
    done
    fail "the listing never reached $want rows, it is at total=$total row=$row"
}

# Rows are listed, so a poll on "not loading" is what says the pane is ready after a path change.
wait_listed() {
    local row
    for _attempt in $(seq 1 600); do
        row=$(ipc rowAt 0 2>/dev/null || printf loading)
        [[ "$row" != "loading" ]] && return
        sleep 0.05
    done
    fail "the listing never settled"
}

wait_path() {
    expect "pane path" "$1" ipc path
    wait_listed
}

# The listing index of the first row whose name matches a glob, or -1: names belong to the stage
# set and can change under this drive, so beats ask for "*.pdf" rather than a file they remember.
row_index_matching() {
    local want="$1" i total name
    total=$(ipc total)
    [[ "$total" =~ ^[0-9]+$ ]] || { printf -- -1; return; }
    for (( i = 0; i < total && i < 200; i++ )); do
        name=$(ipc rowAt "$i")
        name=${name%%|*}
        [[ "$name" == $want ]] && { printf '%s' "$i"; return; }
    done
    printf -- -1
}

# Walks the cursor to the first row matching a glob, from the top, one visible step at a time.
seek_row() {
    local want="$1" target i
    target=$(row_index_matching "$want")
    (( target >= 0 )) || fail "no row matches $want in $(ipc path)"
    key g
    expect_ipc cursor 0
    for (( i = 1; i <= target; i++ )); do
        key j
        expect_ipc cursor "$i"
    done
}

# ------------------------------------------------------------------ the pointer

# Motion goes through uinput and never through hl.dsp.cursor.move once a button is down: that warp
# emits motion with no frame and Qt dispatches pointer events only on frame, so a drag driven by it
# is never seen by the application. tests/drag.sh measured it: 24 motions, 0 frames.
warp()     { dispatch "hl.dsp.cursor.move({ x = $1, y = $2 })"; }
move_rel() { ydotool mousemove -x "$1" -y "$2" >/dev/null 2>&1; }
press()    { ydotool click 0x40 >/dev/null 2>&1; }
release()  { ydotool click 0x80 >/dev/null 2>&1; }

cursor_pos() {
    hyprctl cursorpos | tr -d ','
}

# Converges on an absolute target with real frame-carrying motion, which is also what a viewer
# sees as the pointer travelling: libinput accelerates about 2x here, so each step is half the
# remaining distance and re-read, never trusted, then single pixels until it is exact.
glide_to() {
    local tx="$1" ty="$2" i cx cy dx dy
    for i in $(seq 1 24); do
        read -r cx cy < <(cursor_pos)
        dx=$(( tx - cx )); dy=$(( ty - cy ))
        (( dx == 0 && dy == 0 )) && return 0
        if (( dx > -5 && dx < 5 && dy > -5 && dy < 5 )); then
            move_rel "$(( dx > 0 ? 1 : dx < 0 ? -1 : 0 ))" "$(( dy > 0 ? 1 : dy < 0 ? -1 : 0 ))"
        else
            move_rel $(( dx / 2 )) $(( dy / 2 ))
        fi
        sleep 0.05
    done
    read -r cx cy < <(cursor_pos)
    (( cx == tx && cy == ty )) || fail "the pointer settled at $cx,$cy, not $tx,$ty"
}

park_pointer() {
    warp "$park_x" "$park_y"
}

# The screen position of a row's centre in one window: the seam answers window coordinates.
row_screen_centre() {
    local ipcfn="$1" addr="$2" index="$3" cx cy wx wy
    read -r cx cy <<< "$("$ipcfn" rowCentre "$index")"
    [[ -n "$cy" ]] || fail "row $index has no on-screen centre"
    read -r wx wy _ww _wh < <(client_geometry "$addr")
    printf '%s %s\n' "$((cx + wx))" "$((cy + wy))"
}

# Empty list area below the last row of a window, for a drop that means "into this directory".
list_blank_spot() {
    local ipcfn="$1" addr="$2" last rowheight cx cy
    last=$(( $("$ipcfn" total) - 1 ))
    (( last >= 0 )) || fail "the window lists nothing to place a drop under"
    rowheight=$("$ipcfn" metrics | cut -d' ' -f4)
    read -r cx cy < <(row_screen_centre "$ipcfn" "$addr" "$last")
    printf '%s %s\n' "$cx" "$(( cy + 2 * rowheight ))"
}

click_at() {
    omarchy-drive click "$1" "$2" "${@:3}" >/dev/null
}

# A drag from one screen point to another through a held left button, at a pace a viewer can follow.
drag() {
    local sx="$1" sy="$2" tx="$3" ty="$4"
    glide_to "$sx" "$sy"
    sleep 0.4
    press
    sleep 0.3
    glide_to "$tx" "$ty"
    sleep 0.5
    release
}

# ------------------------------------------------------------------ the theme

theme_current() {
    omarchy theme current
}

background_current() {
    readlink "$real_state/background"
}

# Two themes that are not the one the box is on, read at run time: the box has been switched under
# a running lane before, and a switch to the current theme would show no re-skin at all.
theme_targets() {
    local current name picked=0
    current=$(theme_current)
    for name in "Tokyo Night" "Catppuccin Latte" "Rose Pine"; do
        [[ "${name,,}" == "${current,,}" ]] && continue
        printf '%s\n' "$name"
        picked=$((picked + 1))
        (( picked == 2 )) && return
    done
}

# Sample input, one line of the live colors.toml:
# background        = "#0e1112"   # window ground
# The ground's luminance decides which way the beat switches: a dark box goes to a light theme and
# a light box to a dark one, so the change is unmistakable on a timeline thumbnail.
live_background_is_dark() {
    local hex r g b
    hex=$(grep -E '^background' "$real_state/theme/colors.toml" | grep -oE '#[0-9A-Fa-f]{6}' | head -1)
    [[ -n "$hex" ]] || fail "no background in the live colors.toml"
    r=$((16#${hex:1:2})); g=$((16#${hex:3:2})); b=$((16#${hex:5:2}))
    # Rec. 601 luma, integer weights that sum to 1000; half of 255 is the line between dark and light.
    (( (299 * r + 587 * g + 114 * b) / 1000 < 128 ))
}

theme_contrast_target() {
    local current name candidates
    current=$(theme_current)
    if live_background_is_dark; then
        candidates=("Catppuccin Latte" "Flexoki Light")
    else
        candidates=("Tokyo Night" "Vernier")
    fi
    for name in "${candidates[@]}"; do
        [[ "${name,,}" == "${current,,}" ]] && continue
        printf '%s\n' "$name"
        return
    done
    fail "no contrasting theme differs from the current one, $current"
}

# Restores what stage found, name then background, because a theme set cycles the theme's backgrounds.
theme_restore() {
    local name bg
    [[ -f "$state" ]] || return 0
    name=$(grep '^theme=' "$state" | cut -d= -f2-)
    bg=$(grep '^background=' "$state" | cut -d= -f2-)
    [[ -n "$name" ]] || return 0
    if [[ "$(theme_current)" != "$name" ]]; then
        omarchy theme set "$name" >/dev/null 2>&1
    fi
    if [[ -n "$bg" && -f "$bg" && "$(background_current)" != "$bg" ]]; then
        omarchy theme bg set "$bg" >/dev/null 2>&1
    fi
    printf 'THEME restored to %s\n' "$(theme_current)"
}

# The switch runs in the background so its terminal and browser hooks never stall the drive's clock.
# Waited on by pid, never by a bare wait: the windows are jobs of this shell too.
theme_pid=0
theme_switch() {
    omarchy theme set "$1" >/dev/null 2>&1 &
    theme_pid=$!
}

theme_wait() {
    (( theme_pid > 0 )) && wait "$theme_pid"
    theme_pid=0
}

# Sample input, one line of the live colors.toml:
# foreground        = "#c8ccd0"   # content ink
live_foreground() {
    grep -E '^foreground' "$real_state/theme/colors.toml" | grep -oE '#[0-9A-Fa-f]{6}'
}

# The window's own palette against the file the theme set just wrote, polled because the watch
# fires on theme.name and the reload is a round trip behind it.
wait_foreground() {
    local want seen
    want=$(live_foreground)
    [[ -n "$want" ]] || fail "no foreground in the live colors.toml"
    for _attempt in $(seq 1 200); do
        seen=$(ipc themeForeground 2>/dev/null)
        [[ "$seen" == "$want" ]] && { printf 'FOREGROUND %s (window agrees with colors.toml)\n' "$seen"; return; }
        sleep 0.05
    done
    fail "the window still paints foreground '$seen' while colors.toml says $want, so the live re-skin did not land"
}

# ------------------------------------------------------------------ the beats

beat_started=0
beat_name=""

now_ms() {
    date +%s%3N
}

# Closes the previous beat's clock and opens the next, so the report is one line per beat.
beat() {
    close_beat
    beat_name="$1"
    beat_started=$(now_ms)
    printf 'BEAT %-10s %s\n' "$1" "$2"
}

close_beat() {
    [[ -n "$beat_name" ]] || return 0
    printf 'TIME %-10s %5.1f s\n' "$beat_name" "$(( $(now_ms) - beat_started ))e-3"
    beat_name=""
}

# A shot of the stage at the beat's peak, only on a dry run: the evidence a visual claim needs.
shot() {
    [[ "$shots" == 1 ]] || return 0
    grim -g "${stage_x},${stage_y} ${stage_w}x${stage_h}" "$evidence/$1.png" || fail "grim failed on $1"
    printf 'SHOT %s\n' "$evidence/$1.png"
}

# Ctrl+1/2/3 are the Finder view chords keys.toml binds (90cd964), so no view needs the pointer.
view() {
    case "$1" in
        list) chord ctrl 1 ;;
        columns) chord ctrl 2 ;;
        grid) chord ctrl 3 ;;
    esac
    expect_ipc viewMode "$1"
}

photos=$fixture/Photos
iceland=$photos/Iceland, March
roll=$photos/Camera roll
roll_two=$photos/Camera roll, day two

# Climbs to the fixture home from anywhere inside it, one h at a time, never above it: the parent
# of ~ is the sandbox root and that name must never be on camera.
goto_home() {
    local attempt
    for attempt in $(seq 1 8); do
        [[ "$(ipc path)" == "$fixture" ]] && return 0
        [[ "$(ipc path)" == "$fixture"/* ]] || fail "the pane is at $(ipc path), outside the home"
        key h
        settle
    done
    fail "could not climb to the home, the pane is at $(ipc path)"
}

# Opens a path under the home by walking rows, so every step is on camera and nothing is typed.
goto_path() {
    local target="$1" rel part
    goto_home
    rel=${target#"$fixture"/}
    [[ "$rel" != "$target" ]] || fail "$target is not under the home"
    while [[ -n "$rel" ]]; do
        part=${rel%%/*}
        [[ "$part" == "$rel" ]] && rel="" || rel=${rel#*/}
        seek_row "$part"
        key -k Return
        wait_path "$(ipc path)/$part"
    done
}

# The opener: the mark painting itself into the empty folder, held under one caption turn, then up
# into the home, nine entries somebody's working files have, and a slow walk down five rows.
beat_open() {
