        expect_ipc cursor "$i"
        dwell 0.6
    done
    dwell 2
    key g
    expect_ipc cursor 0
    dwell 1
}

# Drag out to another application and back in: the second window is a second Flea process, so both
# drops arrive over the compositor's data device as text/uri-list, the way any application's would.
beat_drag() {
    local sx sy tx ty from_b
    beat drag "into the Iceland photos; the window makes room, a second one opens; a photo out, a PDF back in"
    goto_path "$iceland"
    dwell 2
    place "$addr_a" "$(pair_x)" "$(pair_y)" "$pair_w" "$height"
    dwell 1
    read -r pid_b id_b addr_b < <(spawn "$fixture/Documents")
    place "$addr_b" "$(side_x)" "$(pair_y)" "$pair_w" "$height"
    expect "second window path" "$fixture/Documents" ipc_b path
    omarchy-drive focus "$addr_a" >/dev/null
    dwell 2.5
    shot drag-two-windows

    seek_row 'glacier lagoon at dusk.jpg'
    read -r sx sy < <(row_screen_centre ipc "$addr_a" "$(ipc cursor)")
    read -r tx ty < <(list_blank_spot ipc_b "$addr_b")
    drag "$sx" "$sy" "$tx" "$ty"
    expect_file "$fixture/Documents/glacier lagoon at dusk.jpg"
    expect_message_has_b "z undoes"
    dwell 4.5
    shot drag-out

    # Back the other way: a document out of the second window into the first, then undone.
    from_b=$(ipc_b_row_index 'invoice-0142.pdf')
    read -r sx sy < <(row_screen_centre ipc_b "$addr_b" "$from_b")
    read -r tx ty < <(list_blank_spot ipc "$addr_a")
    drag "$sx" "$sy" "$tx" "$ty"
    expect_file "$iceland/invoice-0142.pdf"
    expect_message_has "z undoes"
    dwell 4
    shot drag-in
    park_pointer
    key z
    expect_message_has "Undid the"
    expect_no_file "$iceland/invoice-0142.pdf"
    dwell 2.5

    close_window "$addr_b"
    pid_b=0; id_b=""; addr_b=""
    dwell 0.8
    place "$addr_a" "$(rest_x)" "$(rest_y)" "$width" "$height"
    dwell 1.5
}

# The second window's own row lookup, the same glob walk as row_index_matching over ipc_b.
ipc_b_row_index() {
    local want="$1" i total name
