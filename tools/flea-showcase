# The claim: Flea has no look of its own, it agrees with the desktop. One switch to the other side
# of dark and light, the wallpaper and the window re-skinning together, then back; the window is not
# touched from the first switch to the last frame, so nothing reads as a relaunch.
beat_theme() {
    local target
    beat theme "one live theme switch, dark to light or light to dark, wallpaper and window together, then back"
    target=$(theme_contrast_target)
