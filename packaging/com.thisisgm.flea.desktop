[Desktop Entry]
Type=Application
Name=Flea
GenericName=File Manager
Comment=Fast, keyboard-first file manager
# The entry always means the window: without --gui the mode would be inferred from whatever stdio the launcher hands over.
Exec=flea --gui %f
Icon=com.thisisgm.flea
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folder;manager;browser;flea;
StartupWMClass=com.thisisgm.flea
